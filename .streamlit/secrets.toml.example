# Streamlit Secrets Configuration
# Copy this file to .streamlit/secrets.toml and add your actual API keys
# DO NOT commit secrets.toml with your real API keys!

# xAI Grok API (optional)
[xai]
api_key = "your-xai-api-key-here"

# OpenAI GPT API (optional)
[openai]
api_key = "your-openai-api-key-here"

# Alternative: You can also use environment variable names
# [xai]
# api_key = "${XAI_API_KEY}"
# [openai]
# api_key = "${OPENAI_API_KEY}"

# Note: At least one API key should be configured for AI recommendations.
# If both are configured, you can choose which one to use in the app.
